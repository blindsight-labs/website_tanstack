# Copy to .env.local for local dev. In Netlify, set these under
# Site settings → Environment variables.

# Resend (https://resend.com/api-keys) — required for the demo + careers forms.
# Domain `blindsight.io` must be verified in Resend before MAIL_FROM works.
RESEND_API_KEY=

# Sender. Use a noreply alias on the verified domain — no M365 mailbox needed.
MAIL_FROM="Blindsight <noreply@blindsight.io>"

# Notification recipients (must be real mailboxes).
MAIL_TO_DEMO=guilherme.santos@blindsight.io
MAIL_TO_CAREERS=guilherme.santos@blindsight.io

# Google reCAPTCHA v3 (https://www.google.com/recaptcha/admin → v3, domain blindsight.io) —
# spam protection on both forms. The site key is public (build time); the secret is server-only.
# In production a missing secret rejects every submission (fail closed).
# RECAPTCHA_MIN_SCORE: 0 (bot) to 1 (human); submissions below it are refused. Default 0.5.
VITE_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5

# Cookiebot (https://admin.cookiebot.com → Settings → Your scripts) — the domain group ID.
# Build time. Unset: no consent banner AND no Google Analytics (analytics only runs behind consent).
VITE_COOKIEBOT_CBID=

# Microsoft Dataverse — where form submissions are stored (Power Automate turns new rows into
# Jira issues). See docs/forms-dataverse-jira.md. Unset: submissions go by email only.
DATAVERSE_URL=
DATAVERSE_TENANT_ID=
DATAVERSE_CLIENT_ID=
DATAVERSE_CLIENT_SECRET=
